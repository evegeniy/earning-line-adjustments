{
    "name": "alcor/earning-line-adjustments",
    "description": "Proof of concept: audited manual adjustments of a payroll earning line.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "psr/clock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Payroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payroll\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"],
        "demo": "php bin/demo"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpunit/phpunit": "^12"
    }
}
